model Product {
  id                        String   @id @default(uuid())
  title                     String
  description               String
  image_urls                String[]
  price                     Float
  sizes                     String
  verified                  Boolean  @default(false)
  verification_document_url String?
  stock                     Int      @default(0)
  brand_id                  String
  category_id               String
  seller_id                 String

  seller             User               @relation(references: [id], fields: [seller_id], onDelete: Restrict)
  category           ProductCategory    @relation(references: [id], fields: [category_id], onDelete: Restrict)
  brand              Brand              @relation(references: [id], fields: [brand_id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  promotion_products PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, seller_id, category_id, brand_id])
  @@map("products")
}

model ProductCategory {
  id       String    @id @default(uuid())
  title    String
  icon     String?
  products Product[]

  createdAt DateTime @default(now()) @map("craetedAt")
  updatedAt DateTime @updatedAt

  @@index([id])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid())
  title     String
  image_url String?
  products  Product[]
  seller_id String?
  seller    User?     @relation("SellerBrands", fields: [seller_id], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([id, seller_id])
  @@map("brands")
}
