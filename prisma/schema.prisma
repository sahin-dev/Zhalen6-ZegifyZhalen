// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model SitePolicy {
  id        String    @id @default(uuid())
  type      PoliyType
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([id, type])
  @@map("site_policies")
}

enum PoliyType {
  Privacy
  Terms
}

enum UserRole {
  BUYER
  SELLER
  CHECKER
  ADMIN
  SUPER_ADMIN
}

enum NotificationLevel {
  Critical
}

enum NotificationChannel {
  Email
  Firebase
}

enum NotificationType {
  account_created
  order_updated
  message_received
  promotion_updated
  seller_verification_updated
  support_updated
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum BusinessVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SellerDocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  OWNER_ID
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PromotionPlan {
  STARTER
  PREMIUM
  PRO
}

enum PromotionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentPurpose {
  ORDER
  PROMOTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
