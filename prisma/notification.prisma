model Notification {
  id        String                @id @default(uuid())
  title     String
  text      String
  user_id   String
  channels  NotificationChannel[]
  level     NotificationLevel
  type      NotificationType
  readAt    DateTime?
  user      User                  @relation(references: [id], fields: [user_id], onDelete: Restrict)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([id, user_id])
  @@map("notifications")
}
